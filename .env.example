# ===== 运行环境（Issue #3：生产 fail-fast）=====
# dev（默认，允许开发弱默认值）/ production（严格校验：拒绝弱数据库口令、
# change_me 类 JWT_SECRET、不足 32 位的内部令牌、SQLite、关闭 ClamAV 强制扫描）
BIDVOLT_ENV=dev

# ===== 数据库（单容器本机，init 脚本与 app 共用）=====
# 应用账号密码由 init 脚本用于建库；DATABASE_URL 使用同一密码
DATABASE_URL=postgresql+asyncpg://bidvolt:change_me@127.0.0.1:5432/bidvolt
APP_DB_PASSWORD=change_me

# ===== 认证 =====
# JWT 签名密钥（>=32 字符随机串）；MCP server 与后端之间内部认证
JWT_SECRET=change_me
BIDVOLT_INTERNAL_TOKEN=change_me

# ===== 云模型/搜索（P1 门禁）=====
# 仅当 docs/数据分级与授权确认清单.md 签署完成、DATA_CLASSIFICATION_CONFIRMED=1 时，
# CLOUD_LLM_ENABLED / SEARCH_ENABLED 才可置 1；否则启动时强制置 0
DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_VL_MODEL=qwen-vl-max
MINIMAX_API_KEY=
# MINIMAX_BASE_URL=  # 按实际接入文档填写（api.minimax.chat / api.minimaxi.com 等）
ANYSEARCH_KEY=
# ANYSEARCH_BASE_URL=https://api.anysearch.com/mcp  # 官方端点（JSON-RPC 2.0，默认即此值）
# AnySearch 说明：未配置 KEY 时可用匿名额度（约 50 次/天，仅测试用）；
# 生产/正式使用由运维在 Secret Manager 填入注册 Key（1000 次/天额度），
# 匿名模式同样受 DLP 脱敏 + 域名白名单约束。
# 开发/测试默认 SEARCH_MODE=anysearch（匿名出网）；离线环境可改 mock（本地合成结果，不出网）。
SEARCH_MODE=anysearch
DATA_CLASSIFICATION_CONFIRMED=0
CLOUD_LLM_ENABLED=0
# 开发期可用匿名 AnySearch（不传 KEY）；生产上线前需 A2 云端搜索授权签署 + 正式 Key 才置 1
SEARCH_ENABLED=0
CLOUD_DATA_REGION=cn-east
CLOUD_DATA_RETENTION_DAYS=30

# ===== 存储/备份 =====
# /data 为容器外挂持久卷（平台约定）：/data/appdata 业务文件、/data/backups 备份
# virus_scan_required=1 时 ClamAV 不可用则 fail-closed 拒绝入库（生产建议 1）
VIRUS_SCAN_REQUIRED=0
STORAGE_ROOT=/data/appdata
BACKUP_ROOT=/data/backups

# ===== 出站代理（可选，搜索出网优先走代理）=====
# HTTP_PROXY=http://proxy:port
